<Window x:Class="INTViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="INTViewer" Width="960" Height="680" MinWidth="480" MinHeight="420"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseWheel="Window_PreviewMouseWheel">
    <Grid x:Name="RootGrid">
        <Grid x:Name="LibraryView" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="*" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="INTViewer" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Margin="0,6,0,0" Text="최근 파일을 이어서 열거나 새 텍스트 파일을 추가하세요. 뷰 페이지에서는 Esc로 돌아올 수 있습니다." Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,8,0" Content="환경설정" Click="SettingsButton_Click" Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource SecondaryButtonTextBrush}" />
                    <Button Content="+ 새 파일 열기" Click="OpenFile_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="20,16" Text="최근 파일" FontSize="16" FontWeight="SemiBold" />

                    <Grid Grid.Row="1">
                        <ListBox x:Name="RecentFilesList" Margin="12,0" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="RecentFilesList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="10" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemCard" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemCard" Property="Background" Value="{DynamicResource ItemHoverBrush}" /></Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemCard" Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
                                                        <Setter TargetName="ItemCard" Property="BorderBrush" Value="{DynamicResource ItemSelectedBorderBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <EventSetter Event="MouseDoubleClick" Handler="RecentFileItem_MouseDoubleClick" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding Location}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                            <TextBlock Text="{Binding LastOpenedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding StatusText}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="EmptyHistoryPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="아직 열어본 파일이 없습니다." FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,8,0,0" Text="위의 ‘새 파일 열기’를 눌러 .txt 파일을 추가해 보세요." Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="RemoveSelectedButton" Margin="0,0,8,0" Content="목록에서 제거" Click="RemoveSelected_Click" IsEnabled="False" Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource SecondaryButtonTextBrush}" />
                            <Button x:Name="OpenSelectedButton" Content="선택한 파일 열기" Click="OpenSelected_Click" IsEnabled="False" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="4" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="기록 설정" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0" Text="최근 파일 기록은 실행 파일 옆의 history.json에 저장됩니다." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                    </StackPanel>
                    <Button Content="최근 기록 모두 지우기" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClearHistory_Click" Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource SecondaryButtonTextBrush}" />
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ViewerView" Visibility="Collapsed" SizeChanged="ViewerView_SizeChanged">
            <Border x:Name="ViewerBackground" Background="White" />

            <TextBox x:Name="ContentTextBox" Padding="32,28" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0" Background="Transparent" FontFamily="Consolas, Malgun Gothic" FontSize="14"
                     SelectionBrush="#FACC15" SelectionOpacity="0.65" SpellCheck.IsEnabled="False"
                     SelectionChanged="ContentTextBox_SelectionChanged" />

            <Grid x:Name="PageView" Visibility="Collapsed">
                <Border x:Name="PageContentArea" Margin="32,28,32,28">
                    <TextBlock x:Name="PageTextBlock" TextWrapping="Wrap" FontFamily="Consolas, Malgun Gothic" FontSize="14" />
                </Border>

                <Border Height="54" Width="220" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="Transparent" Panel.ZIndex="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0.12" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1" /></Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border Background="#DD111827" CornerRadius="18" Padding="8,4" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="‹" Click="PreviousPage_Click" Padding="4" Background="Transparent" FontSize="20" />
                            <TextBlock Grid.Column="1" x:Name="PageIndicatorText" Text="1 / 1" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <Button Grid.Column="2" Content="›" Click="NextPage_Click" Padding="4" Background="Transparent" FontSize="20" />
                        </Grid>
                    </Border>
                </Border>
            </Grid>

            <Border Width="174" Height="76" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Panel.ZIndex="20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Opacity" Value="0" />
                            <Setter Property="Width" Value="42" />
                            <Setter Property="Height" Value="42" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="3,0" />
                            <Setter Property="Background" Value="#DD111827" />
                            <Setter Property="FontSize" Value="19" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>
                    <Button Content="←" Click="BackToLibrary_Click" ToolTip="목록 페이지" />
                    <Button Content="⌕" Click="SearchButton_Click" ToolTip="검색 및 이동" />
                    <Button Content="⚙" Click="SettingsButton_Click" ToolTip="환경설정" />
                </StackPanel>
            </Border>

            <Border x:Name="SettingsPanel" Width="330" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Margin="0,64,20,20" Padding="20" Background="#FAFFFFFF" BorderBrush="#D0D5DD" BorderThickness="1"
                    TextElement.Foreground="#101828" CornerRadius="10" Visibility="Collapsed" Panel.ZIndex="30">
                <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" /></Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <TextBlock Text="환경설정" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Content="×" HorizontalAlignment="Right" Width="32" Height="32" Padding="0" FontSize="20"
                                    Background="Transparent" Foreground="#344054" Click="CloseSettings_Click" />
                        </Grid>

                        <TextBlock Text="색상" FontWeight="SemiBold" />
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="화이트 모드" Click="WhiteMode_Click" Background="#F2F4F7" Foreground="#111827" />
                            <Button Grid.Column="2" Content="다크 모드" Click="DarkMode_Click" Background="#111827" Foreground="#F9FAFB" />
                        </Grid>
                        <Grid Margin="0,10,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="BackgroundColorPreview" Width="24" Height="24" CornerRadius="4" BorderBrush="#98A2B3" BorderThickness="1" />
                                <TextBlock Margin="10,0,0,0" Text="배경색" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="색 선택" Click="ChooseBackgroundColor_Click" Background="#E5E7EB" Foreground="#344054" />
                        </Grid>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="TextColorPreview" Width="24" Height="24" CornerRadius="4" BorderBrush="#98A2B3" BorderThickness="1" />
                                <TextBlock Margin="10,0,0,0" Text="글자색" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="색 선택" Click="ChooseTextColor_Click" Background="#E5E7EB" Foreground="#344054" />
                        </Grid>

                        <Separator Margin="0,0,0,18" />
                        <TextBlock Text="보기 방식" FontWeight="SemiBold" />
                        <Grid Margin="0,12,0,20">
                            <TextBlock x:Name="ModeDescriptionText" Text="스크롤로 보기" VerticalAlignment="Center" />
                            <ToggleButton x:Name="PageModeToggle" Width="50" Height="28" HorizontalAlignment="Right"
                                          Checked="ViewMode_Changed" Unchecked="ViewMode_Changed">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                            <Border x:Name="SwitchTrack" Background="#98A2B3" CornerRadius="14" />
                                            <Ellipse x:Name="SwitchThumb" Width="22" Height="22" Margin="3" Fill="White" HorizontalAlignment="Left" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="SwitchTrack" Property="Background" Value="#2563EB" />
                                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>

                        <Separator Margin="0,0,0,18" />
                        <TextBlock Text="읽기 여백" FontWeight="SemiBold" />
                        <Grid Margin="0,12,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                            <TextBlock Text="위" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" x:Name="MarginTopSlider" Minimum="0" Maximum="120" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="ReaderLayoutSlider_ValueChanged" />
                            <TextBlock Grid.Column="2" x:Name="MarginTopValueText" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                            <TextBlock Text="아래" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" x:Name="MarginBottomSlider" Minimum="0" Maximum="120" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="ReaderLayoutSlider_ValueChanged" />
                            <TextBlock Grid.Column="2" x:Name="MarginBottomValueText" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                            <TextBlock Text="왼쪽" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" x:Name="MarginLeftSlider" Minimum="0" Maximum="120" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="ReaderLayoutSlider_ValueChanged" />
                            <TextBlock Grid.Column="2" x:Name="MarginLeftValueText" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                            <TextBlock Text="오른쪽" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" x:Name="MarginRightSlider" Minimum="0" Maximum="120" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="ReaderLayoutSlider_ValueChanged" />
                            <TextBlock Grid.Column="2" x:Name="MarginRightValueText" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Margin="0,0,0,18" />
                        <TextBlock Text="글자 크기" FontWeight="SemiBold" />
                        <Grid Margin="0,12,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                            <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ReaderLayoutSlider_ValueChanged" />
                            <TextBlock Grid.Column="1" x:Name="FontSizeValueText" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Margin="0,16,0,18" />
                        <TextBlock Text="폰트" FontWeight="SemiBold" />
                        <ComboBox x:Name="FontFamilyComboBox" Margin="0,10,0,16" Padding="8,6"
                                  SelectionChanged="FontFamilyComboBox_SelectionChanged" />

                        <TextBlock Text="글자 서식" FontWeight="SemiBold" />
                        <StackPanel Margin="0,10,0,4" Orientation="Horizontal">
                            <ToggleButton x:Name="BoldToggle" Margin="0,0,8,0" Content="굵게" Checked="FontStyleToggle_Changed" Unchecked="FontStyleToggle_Changed" />
                            <ToggleButton x:Name="ItalicToggle" Content="기울임" Checked="FontStyleToggle_Changed" Unchecked="FontStyleToggle_Changed" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="SearchPanel" Width="330" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,64,20,0" Padding="20" Background="#FAFFFFFF" BorderBrush="#D0D5DD" BorderThickness="1"
                    TextElement.Foreground="#101828" CornerRadius="10" Visibility="Collapsed" Panel.ZIndex="30">
                <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" /></Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <TextBlock Text="검색 및 이동" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Content="×" HorizontalAlignment="Right" Width="32" Height="32" Padding="0" FontSize="20"
                                Background="Transparent" Foreground="#344054" Click="CloseSearch_Click" />
                    </Grid>

                    <TextBlock Text="검색" FontWeight="SemiBold" />
                    <TextBox x:Name="SearchTextBox" Margin="0,10,0,8" Padding="10,7" KeyDown="SearchTextBox_KeyDown" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="이전" Click="FindPrevious_Click" Background="#E5E7EB" Foreground="#344054" />
                        <Button Grid.Column="2" Content="다음" Click="FindNext_Click" />
                    </Grid>
                    <TextBlock x:Name="SearchResultText" Margin="0,4,0,18" Foreground="#667085" FontSize="12" />

                    <Separator Margin="0,0,0,18" />
                    <Grid>
                        <TextBlock Text="이동" FontWeight="SemiBold" />
                        <TextBlock x:Name="CurrentPositionText" Text="1 / 1" HorizontalAlignment="Right" Foreground="#667085" />
                    </Grid>
                    <TextBlock x:Name="MoveDescriptionText" Margin="0,8,0,0" Text="이동할 줄 번호" Foreground="#667085" FontSize="12" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="MoveTargetTextBox" Padding="10,7" KeyDown="MoveTargetTextBox_KeyDown" />
                        <Button Grid.Column="2" Content="이동" Click="MoveToTarget_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
