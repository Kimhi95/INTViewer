<Window x:Class="INTViewer.ModernDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="알림" Width="420" MaxWidth="520" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Dialog_PreviewKeyDown">
    <Border Margin="18" Padding="24" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18"
            TextElement.Foreground="{DynamicResource PrimaryTextBrush}" MouseLeftButtonDown="Dialog_MouseLeftButtonDown">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.28" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBorder" Width="36" Height="36" HorizontalAlignment="Left" CornerRadius="11">
                    <TextBlock x:Name="IconText" Foreground="White" FontSize="19" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" Content="×" Width="32" Height="32" Padding="0" FontSize="19"
                        Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}"
                        Click="CloseButton_Click" AutomationProperties.Name="알림 닫기" />
            </Grid>

            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,20,0,24" FontSize="14" LineHeight="22"
                       Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" MinWidth="92" Margin="0,0,9,0" Style="{StaticResource SecondaryButtonStyle}"
                        Click="CancelButton_Click" IsCancel="True" />
                <Button x:Name="ConfirmButton" MinWidth="92" Click="ConfirmButton_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
